---
import { fetchDataSource, getPageIdsFromSource, getPageContent } from '../api/fetch-data-source.js'

const data = await fetchDataSource()
const dataResults = data.results
const pageTitles = []
const pageTitlesArray = data.results.map((page) =>
  pageTitles.push(page.properties.Title.title.map((item) => item.text.content)),
)
const pageIds = await getPageIdsFromSource()

const pageContent = await Promise.all(pageIds.map((id) => getPageContent(id)))
const arrOfBlocks = pageContent[0].results
---

<pre>{JSON.stringify(arrOfBlocks.map(block => block.type))}</pre>
<pre>{JSON.stringify(pageTitles, null, 4)}</pre>
<pre>{JSON.stringify(data.results.map(page => page.properties.Title.title.map(object => object.text.content)), null, 4)}</pre>
<ul>{pageIds.map((id) => <li>{id}</li>)}</ul>
<pre>
  {JSON.stringify(pageContent, null, 4)}
</pre>
